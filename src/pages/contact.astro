---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Hubungi Zaidly Agency - Konsultasi Website UMKM Gratis"
  description="Konsultasi gratis pembuatan website UMKM profesional bersama Zaidly Agency. Hubungi via WhatsApp sekarang, respon cepat, harga mulai Rp 588.000."
  keywords="kontak zaidly agency, konsultasi website umkm gratis, order jasa website jakarta, hubungi digital agency"
>

  <!-- Page header -->
  <section class="relative pt-40 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-[#060608]"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px]
                bg-[radial-gradient(ellipse,rgba(62,207,142,0.12)_0%,transparent_65%)]
                pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 right-0 h-[1px]
                bg-gradient-to-r from-transparent via-[#3ECF8E]/30 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
      <span class="section-label mx-auto">Get In Touch</span>
      <h1 class="font-heading font-black uppercase text-6xl md:text-8xl leading-[0.85] tracking-tighter text-white">
        Kontak Kami
      </h1>
    </div>
  </section>

  <!-- Content -->
  <section class="py-24 bg-[#050507]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-start">

        <!-- Left info -->
        <div class="space-y-12">
          <div>
            <h2 class="font-heading font-black uppercase text-4xl md:text-5xl leading-[0.9] tracking-tighter text-white mb-4">
              Mari Bicara Tentang
              <span class="text-gradient-static block">Project Anda</span>
            </h2>
            <p class="text-white/40 text-base leading-relaxed max-w-md">
              Ceritakan kebutuhan Anda dan kami akan memberikan solusi terbaik.
              Konsultasi gratis, respon cepat.
            </p>
          </div>

          <div class="space-y-8">
            <div class="flex items-start gap-5">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 text-xl"
                   style="background: linear-gradient(135deg, rgba(62,207,142,0.15), rgba(163,230,53,0.15));
                          border: 1px solid rgba(62,207,142,0.2);">
                📍
              </div>
              <div>
                <h4 class="font-heading font-black text-[10px] uppercase tracking-[0.3em] text-white mb-1">
                  Kantor Kami
                </h4>
                <p class="text-white/40 text-sm">Jl. H Taha, Kebon Jeruk, Jakarta</p>
              </div>
            </div>

            <div class="flex items-start gap-5">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 text-xl"
                   style="background: linear-gradient(135deg, rgba(62,207,142,0.15), rgba(163,230,53,0.15));
                          border: 1px solid rgba(62,207,142,0.2);">
                📞
              </div>
              <div>
                <h4 class="font-heading font-black text-[10px] uppercase tracking-[0.3em] text-white mb-1">
                  WhatsApp
                </h4>
                <p class="text-white/40 text-sm">+62 812 7420 3815</p>
              </div>
            </div>
          </div>

          <!-- Trust signals -->
          <div class="flex gap-6 pt-4">
            <div class="text-center">
              <div class="font-heading font-black text-3xl text-white">100+</div>
              <div class="text-white/40 text-[10px] uppercase tracking-widest mt-1">Proyek</div>
            </div>
            <div class="w-px bg-white/[0.06]"></div>
            <div class="text-center">
              <div class="font-heading font-black text-3xl text-white">98%</div>
              <div class="text-white/40 text-[10px] uppercase tracking-widest mt-1">Puas</div>
            </div>
            <div class="w-px bg-white/[0.06]"></div>
            <div class="text-center">
              <div class="font-heading font-black text-3xl text-white">3x</div>
              <div class="text-white/40 text-[10px] uppercase tracking-widest mt-1">ROI</div>
            </div>
          </div>
        </div>

        <!-- Right form -->
        <div class="card-premium p-10 rounded-[24px]">
          <div class="space-y-6">

            <div>
              <label class="block font-heading font-black text-[9px] uppercase tracking-[0.3em] text-white/40 mb-2">
                Nama Lengkap
              </label>
              <input type="text" id="wa_name"
                     class="w-full px-5 py-4 rounded-xl text-sm text-white placeholder-white/20
                            bg-white/[0.04] border border-white/[0.08]
                            focus:border-[#3ECF8E]/60 focus:outline-none focus:bg-white/[0.06]
                            transition-all duration-300"
                     placeholder="Contoh: Zaid" />
            </div>

            <div>
              <label class="block font-heading font-black text-[9px] uppercase tracking-[0.3em] text-white/40 mb-2">
                Pilih Paket
              </label>
              <select id="wa_package"
                      class="w-full px-5 py-4 rounded-xl text-sm text-white
                             bg-[#0f0f14] border border-white/[0.08]
                             focus:border-[#3ECF8E]/60 focus:outline-none
                             transition-all duration-300 cursor-pointer">
                <option value="Basic (IDR 588k)">Paket Basic (IDR 588k)</option>
                <option value="Pro (IDR 1.000k)">Paket Pro (IDR 1.000k)</option>
                <option value="Business (IDR 2.588k)">Paket Business (IDR 2.588k)</option>
                <option value="Belum tahu, mau konsultasi dulu">Belum tahu, mau konsultasi dulu</option>
              </select>
            </div>

            <div>
              <label class="block font-heading font-black text-[9px] uppercase tracking-[0.3em] text-white/40 mb-2">
                Pesan / Detail Project
              </label>
              <textarea id="wa_message" rows="4"
                        class="w-full px-5 py-4 rounded-xl text-sm text-white placeholder-white/20
                               bg-white/[0.04] border border-white/[0.08]
                               focus:border-[#3ECF8E]/60 focus:outline-none focus:bg-white/[0.06]
                               transition-all duration-300 resize-none"
                        placeholder="Ceritakan kebutuhan website Anda..."></textarea>
            </div>

            <button id="btn_wa"
                    class="btn-premium w-full py-5 flex items-center justify-center gap-3 text-[10px]">
              Kirim ke WhatsApp
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM11.997 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.978-1.402A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10S17.52 2 11.997 2z"/>
              </svg>
            </button>

          </div>
        </div>

      </div>
    </div>
  </section>

  <script is:inline>
    document.getElementById('btn_wa').addEventListener('click', function() {
      const name = document.getElementById('wa_name').value;
      const pkg = document.getElementById('wa_package').value;
      const msg = document.getElementById('wa_message').value;
      const phone = "6281274203815";

      if (!name || !msg) {
        alert("Nama dan Pesan jangan kosong bos!");
        return;
      }

      const text = `Halo Zaidly Agency,%0A%0ANama: ${name}%0APaket: ${pkg}%0APesan: ${msg}`;
      window.open(`https://wa.me/${phone}?text=${text}`, '_blank');
    });
  </script>

</Layout>
