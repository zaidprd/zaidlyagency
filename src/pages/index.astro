---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import SayaButuh from '../components/SayaButuh.astro';
import Packages from '../components/Packages.astro';
import WhyUs from '../components/WhyUs.astro';
import Support from '../components/Support.astro';
import Footer from '../components/Footer.astro';
import PromoBar from '../components/PromoBar.astro';
---

<Layout title="Zaidly Agency | Jasa Pembuatan Website Profesional">
    <header class="relative z-[120]">
        <PromoBar /> 
        <Navbar />
    </header>

    <main class="flex flex-col relative z-10">
        <Hero />
        <div class="bg-[#001f1f]"> <SayaButuh />
            <Packages />
            <WhyUs />
            <Support />
        </div>
    </main>

    <Footer />
</Layout>