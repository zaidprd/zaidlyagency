---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const apps = [
  {
    name: 'Artikel SEO',
    tagline: 'AI Content Generator #1 Indonesia',
    desc: 'Platform berbasis AI untuk generate artikel SEO-optimized dalam bahasa Indonesia. Dukung multi-model AI (Gemini, GPT, Claude), auto-publish ke WordPress dengan integrasi Yoast SEO, dan bulk generate hingga 100 artikel sekaligus.',
    url: 'https://seo.zaidly.com/',
    accent: '#3ECF8E',
    accentSecondary: '#A3E635',
    features: ['Generate artikel < 60 detik', 'Auto-publish ke WordPress', 'Bulk 100 artikel', 'Multi-model AI'],
    tags: ['AI', 'SEO', 'WordPress', 'Content'],
    badge: 'Most Popular',
  },
  {
    name: 'KapurPad',
    tagline: 'Catatan Harian Digital',
    desc: 'Aplikasi Android untuk pencatatan harian yang bersih, ringan, dan intuitif. Tulis dan kelola catatan Anda langsung dari HP. Download APK-nya secara gratis lewat tombol di bawah.',
    url: 'https://drive.google.com/file/d/1rIo0VeQBM_b68zSQc2Dh869n4gLxtacw/view?usp=sharing',
    accent: '#A3E635',
    accentSecondary: '#3ECF8E',
    features: ['Antarmuka bersih', 'Ringan & cepat', 'Android APK', 'Gratis'],
    tags: ['Notes', 'Diary', 'Android'],
    badge: null,
    cta: 'Download APK',
    note: 'Aplikasi ini 100% aman digunakan. Saat ini belum tersedia di Play Store karena biaya pendaftaran developer ($25) — versi APK ini sama persis, bedanya hanya belum diunggah ke Play Store.',
  },
  {
    name: 'CompanyGen.AI',
    tagline: 'Company Profile Generator AI',
    desc: 'Generate website company profile profesional menggunakan AI dalam hitungan menit tanpa coding. Preview gratis, bayar hanya saat publish. Mulai dari Rp 25.000 — solusi terjangkau untuk UMKM.',
    url: 'https://web-generet.vercel.app/',
    accent: '#06b6d4',
    accentSecondary: '#3ECF8E',
    features: ['AI-generated website', 'Free demo preview', '7 halaman website', 'Mulai Rp 25.000'],
    tags: ['AI', 'Website', 'Company Profile'],
    badge: 'New',
  },
  {
    name: 'Konversi',
    tagline: 'Konversi File Online Gratis',
    desc: 'Tool konversi file JPG, PNG & PDF secara online dan gratis. Tidak perlu install software, tidak perlu daftar akun — langsung convert di browser dengan tampilan yang bersih dan minimalis.',
    url: 'https://konversi.pages.dev/',
    accent: '#10b981',
    accentSecondary: '#3ECF8E',
    features: ['JPG ↔ PNG ↔ PDF', 'Browser-based', 'Gratis selamanya', 'Tanpa daftar akun'],
    tags: ['Tools', 'Convert', 'PDF', 'Image'],
    badge: 'Free',
  },
];
---

<Layout
  title="Aplikasi Kami | Zaidly — Tools Digital Buatan Sendiri"
  description="Koleksi aplikasi dan tools digital yang dibangun oleh Zaidly. AI content generator, catatan harian, company profile AI, dan konversi file gratis."
>

  <!-- Page header -->
  <section class="relative pt-40 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-[#060608]"></div>
    <!-- Ambient glow -->
    <div class="absolute top-0 left-1/3 w-[600px] h-[400px]
                bg-[radial-gradient(ellipse,rgba(62,207,142,0.12)_0%,transparent_65%)]
                pointer-events-none"></div>
    <div class="absolute top-0 right-1/4 w-[500px] h-[300px]
                bg-[radial-gradient(ellipse,rgba(163,230,53,0.10)_0%,transparent_65%)]
                pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 right-0 h-[1px]
                bg-gradient-to-r from-transparent via-[#3ECF8E]/30 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
      <span class="section-label mx-auto">Built by Zaidly</span>
      <h1 class="font-heading font-black uppercase text-6xl md:text-8xl leading-[0.85] tracking-tighter text-white">
        Aplikasi
        <span class="text-gradient-static block">Kami</span>
      </h1>
      <p class="mt-6 text-white/40 max-w-xl mx-auto text-base leading-relaxed">
        Tools dan aplikasi digital yang kami bangun untuk membantu individu, UMKM, dan bisnis Indonesia berkembang secara digital.
      </p>
    </div>
  </section>

  <!-- Apps showcase -->
  <main class="py-24 bg-[#050507]">
    <div class="max-w-7xl mx-auto px-6 space-y-12">

      {apps.map((app, i) => (
        <div class={`group relative rounded-[28px] border border-white/[0.06] bg-[#0a0a0f]
                     overflow-hidden hover:border-white/[0.1]
                     transition-all duration-500 hover:-translate-y-1
                     shadow-[0_20px_60px_rgba(0,0,0,0.4)]
                     hover:shadow-[0_40px_80px_rgba(0,0,0,0.6)]
                     ${i % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>

          <!-- Ambient glow blob -->
          <div class="absolute top-0 right-0 w-[400px] h-[300px] pointer-events-none opacity-40"
               style={`background: radial-gradient(ellipse at top right, ${app.accent}22 0%, transparent 65%);`}></div>

          <div class={`flex flex-col lg:flex-row ${i % 2 === 1 ? 'lg:flex-row-reverse' : ''} items-stretch`}>

            <!-- App preview / visual side -->
            <div class="lg:w-2/5 relative overflow-hidden min-h-[280px] lg:min-h-[360px]"
                 style={`background: linear-gradient(135deg, ${app.accent}18, ${app.accentSecondary}10);`}>

              <!-- Decorative grid -->
              <div class="absolute inset-0 opacity-[0.04]"
                   style="background-image: linear-gradient(rgba(255,255,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>

              <!-- App name big -->
              <div class="absolute inset-0 flex flex-col items-center justify-center p-10 text-center">
                <div class="mb-6 w-20 h-20 rounded-[20px] flex items-center justify-center text-4xl font-heading font-black"
                     style={`background: linear-gradient(135deg, ${app.accent}30, ${app.accentSecondary}20);
                             border: 1px solid ${app.accent}30;
                             color: white;`}>
                  {app.name.charAt(0)}
                </div>
                <div class="font-heading font-black uppercase text-3xl md:text-4xl tracking-tighter text-white text-center leading-[0.9]">
                  {app.name}
                </div>
                <div class="mt-3 text-[11px] font-bold uppercase tracking-[0.25em] text-center"
                     style={`color: ${app.accent};`}>
                  {app.tagline}
                </div>
              </div>
            </div>

            <!-- Content side -->
            <div class="lg:w-3/5 p-10 lg:p-14 flex flex-col justify-center">

              <!-- Badge + tags row -->
              <div class="flex items-center gap-3 flex-wrap mb-6">
                {app.badge && (
                  <span class="font-heading font-black text-[9px] uppercase tracking-[0.3em] px-3 py-1.5 rounded-full"
                        style={`background: ${app.accent}20; color: ${app.accent}; border: 1px solid ${app.accent}30;`}>
                    {app.badge}
                  </span>
                )}
                {app.tags.map((tag) => (
                  <span class="font-heading font-black text-[9px] uppercase tracking-[0.3em]
                               px-3 py-1.5 rounded-full border border-white/[0.06] text-white/30">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Description -->
              <p class="text-white/50 text-base leading-relaxed mb-8 max-w-lg">
                {app.desc}
              </p>

              <!-- Features -->
              <ul class="grid grid-cols-2 gap-3 mb-10">
                {app.features.map((feat) => (
                  <li class="flex items-center gap-2.5 text-[12px] font-bold uppercase tracking-wide text-white/60">
                    <span class="w-1.5 h-1.5 rounded-full shrink-0"
                          style={`background: ${app.accent};`}></span>
                    {feat}
                  </li>
                ))}
              </ul>

              <!-- CTA -->
              <div>
                <a href={app.url} target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-3 px-8 py-4 rounded-[12px]
                          font-heading font-black text-[10px] uppercase tracking-[0.2em] text-white
                          transition-all duration-300 hover:-translate-y-0.5 active:scale-95"
                   style={`background: linear-gradient(135deg, ${app.accent}, ${app.accentSecondary});
                           box-shadow: 0 8px 24px ${app.accent}40;`}>
                  {app.cta ?? 'Buka Aplikasi'}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15,3 21,3 21,9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                </a>
                {app.note && (
                  <p class="mt-5 max-w-lg text-[12px] leading-relaxed text-white/40
                            border border-white/[0.07] bg-white/[0.02] rounded-xl px-4 py-3">
                    <span class="font-bold" style={`color: ${app.accent};`}>Catatan:</span> {app.note}
                  </p>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}

    </div>

    <!-- Bottom section: CTA to build custom app -->
    <div class="max-w-7xl mx-auto px-6 mt-32">
      <div class="relative rounded-[28px] border border-white/[0.06] bg-[#0a0a0f]
                  overflow-hidden p-16 text-center">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(62,207,142,0.08)_0%,transparent_65%)]"></div>
        <div class="relative z-10">
          <span class="section-label mx-auto">Mau Punya Aplikasi Sendiri?</span>
          <h2 class="font-heading font-black uppercase text-4xl md:text-6xl leading-[0.85]
                     tracking-tighter text-white mt-4 mb-4">
            Kami bisa membantu
          </h2>
          <p class="text-white/40 text-base max-w-lg mx-auto mb-10">
            Dari website landing page sampai web application, tim kami siap mewujudkan ide digital Anda.
          </p>
          <a href="https://wa.me/6281274203815"
             class="btn-premium inline-flex items-center gap-3 px-10 py-4">
            Diskusi Project
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM11.997 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.978-1.402A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10S17.52 2 11.997 2z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

  </main>

</Layout>
