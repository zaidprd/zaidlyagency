---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import port1 from '../assets/portfolio-1.webp';
import port2 from '../assets/portfolio-2.webp';
import port3 from '../assets/portfolio-3.webp';
import port4 from '../assets/portfolio-4.webp';
import port5 from '../assets/portfolio-5.webp';
import port6 from '../assets/portfolio-6.webp';

const projects = [
  { title: "Panel Maker Type Test", category: "Company Profile", image: port1, link: "https://bloksetschneider.com/" },
  { title: "Konsultan Bisnis", category: "Company Profile", image: port2, link: "https://jayakonsultanbisnis.com/" },
  { title: "Sales Panel", category: "Marketing", image: port3, link: "https://yudisimetri.pages.dev/" },
  { title: "Logistik", category: "Company Profile", image: port4, link: "https://deltalogistik.id/" },
  { title: "Affiliate Marketing", category: "Affiliate", image: port5, link: "https://zaidly.pages.dev" },
  { title: "Sertifikasi ISO", category: "Company Profile", image: port6, link: "https://induscipta.com/" },
];
---

<Layout
  title="Portofolio Proyek Terkini | Zaidly Agency"
  description="Kumpulan hasil karya digital terbaik Zaidly Agency dalam membantu UMKM dan bisnis go-online dengan website profesional."
>

  <!-- Page header -->
  <section class="relative pt-40 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-[#060608]"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px]
                bg-[radial-gradient(ellipse,rgba(188,82,238,0.12)_0%,transparent_65%)]
                pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 right-0 h-[1px]
                bg-gradient-to-r from-transparent via-[#BC52EE]/30 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
      <span class="section-label mx-auto">Our Work</span>
      <h1 class="font-heading font-black uppercase text-6xl md:text-8xl leading-[0.85] tracking-tighter text-white">
        Portfolio
      </h1>
      <p class="mt-6 text-white/40 max-w-xl mx-auto text-base leading-relaxed">
        Hasil karya digital terbaik kami dalam membantu UMKM dan bisnis go-online dengan website profesional.
      </p>
    </div>
  </section>

  <!-- Projects grid -->
  <main class="py-24 bg-[#050507]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((item) => (
          <a
            href={item.link}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Lihat detail proyek ${item.title}`}
            class="group relative block rounded-[20px] overflow-hidden
                   border border-white/[0.06] bg-[#0f0f14]
                   shadow-[0_20px_60px_rgba(0,0,0,0.4)]
                   hover:-translate-y-2 hover:border-white/[0.12]
                   transition-all duration-500"
          >
            <div class="relative aspect-[4/3] overflow-hidden">
              <Image
                src={item.image}
                alt={`Tampilan website portofolio ${item.title} oleh Zaidly Agency`}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <!-- Dark overlay default, lighter on hover -->
              <div class="absolute inset-0 bg-gradient-to-t from-[#050507] via-[#050507]/40 to-transparent
                          transition-opacity duration-500"></div>

              <!-- Hover overlay -->
              <div class="absolute inset-0
                          bg-gradient-to-br from-[#3245FF]/80 to-[#BC52EE]/80
                          opacity-0 group-hover:opacity-100
                          transition-opacity duration-500
                          flex items-center justify-center">
                <span class="font-heading font-black text-[10px] uppercase tracking-[0.4em] text-white
                             border border-white/40 px-6 py-3 rounded-lg
                             backdrop-blur-sm bg-white/10">
                  View Project →
                </span>
              </div>
            </div>

            <div class="p-6">
              <span class="section-label mb-3" style="margin-bottom:0.5rem;">{item.category}</span>
              <h2 class="font-heading font-black uppercase text-lg tracking-tight text-white
                         group-hover:text-gradient-static transition-all">
                {item.title}
              </h2>
            </div>
          </a>
        ))}
      </div>

      <!-- CTA bottom -->
      <div class="mt-24 text-center">
        <p class="text-white/40 text-sm mb-8">Siap bergabung dengan klien kami?</p>
        <a href="https://wa.me/6281274203815"
           class="btn-premium inline-flex items-center gap-3 px-10 py-4">
          Mulai Project Sekarang
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM11.997 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.978-1.402A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10S17.52 2 11.997 2z"/>
          </svg>
        </a>
      </div>
    </div>
  </main>

</Layout>
