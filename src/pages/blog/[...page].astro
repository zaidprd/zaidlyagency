---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { client, urlFor } from '../../lib/sanity';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await client.fetch(`*[_type == "post"] | order(publishedAt desc) {
    title,
    "slug": slug.current,
    mainImage,
    publishedAt,
    excerpt,
    "authorName": author->name,
    "categories": categories[]->title
  }`);

  const sidebarPosts = allPosts.slice(0, 5);
  const allCategories = [...new Set(allPosts.flatMap((p: any) => p.categories || []))];

  return paginate(allPosts, {
    pageSize: 7,
    props: { sidebarPosts, allCategories },
  });
}) satisfies GetStaticPaths;

const { page, sidebarPosts, allCategories } = Astro.props as any;

const isFirstPage = page.currentPage === 1;
const heroPost   = isFirstPage ? page.data[0] : null;
const sidePosts  = isFirstPage ? page.data.slice(1, 3) : [];
const gridPosts  = isFirstPage ? page.data.slice(3) : page.data;

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Layout
  title={`Blog Zaidly Agency - Halaman ${page.currentPage}`}
  description="Artikel seputar jasa website, SEO, dan tips digital marketing untuk UMKM Indonesia dari Zaidly Agency."
>

  <!-- Compact page header -->
  <section class="relative pt-28 pb-10 overflow-hidden">
    <div class="absolute inset-0 bg-[#0B0C0B]"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[240px]
                bg-[radial-gradient(ellipse,rgba(62,207,142,0.12)_0%,transparent_65%)]
                pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="section-label">Our Insights</span>
        <h1 class="font-heading font-extrabold text-4xl md:text-5xl tracking-tight text-white">
          Blog <span class="word-accent">Zaidly</span>
        </h1>
      </div>
      <p class="text-white/45 text-sm max-w-xs leading-relaxed">
        Tips website, SEO, dan digital marketing untuk UMKM Indonesia.
      </p>
    </div>
  </section>

  <main class="pb-24 bg-[#0B0C0B]">
    <div class="max-w-7xl mx-auto px-6">

      <!-- ── Featured zone (page 1 only) ── -->
      {heroPost && (
        <section class="grid lg:grid-cols-3 gap-5 mb-14">

          <!-- Hero card -->
          <a href={`/${heroPost.slug}`}
             class="group relative lg:col-span-2 rounded-3xl overflow-hidden
                    border border-white/[0.07] hover:border-[#3ECF8E]/35
                    min-h-[320px] md:min-h-[440px] flex items-end
                    transition-all duration-500 hover:-translate-y-1">
            {heroPost.mainImage ? (
              <img
                src={urlFor(heroPost.mainImage).width(1200).url()}
                alt={heroPost.mainImage.alt || heroPost.title}
                class="absolute inset-0 w-full h-full object-cover
                       transition-transform duration-700 group-hover:scale-105"
              />
            ) : (
              <div class="absolute inset-0 bg-gradient-to-br from-[#141614] to-[#0E100E]"></div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B0C0B]/95 via-[#0B0C0B]/40 to-transparent"></div>

            <div class="relative z-10 p-7 md:p-10 w-full">
              <div class="flex items-center gap-3 mb-4 flex-wrap">
                <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-[0.15em]
                             bg-[#3ECF8E] text-[#07100B]">
                  Terbaru
                </span>
                {heroPost.categories?.slice(0, 2).map((cat: string) => (
                  <span class="px-3 py-1 rounded-full text-[11px] font-semibold uppercase tracking-[0.15em]
                               border border-white/20 text-white/70 backdrop-blur-sm">
                    {cat}
                  </span>
                ))}
              </div>
              <h2 class="font-heading font-extrabold text-2xl md:text-4xl leading-[1.12] tracking-tight
                         text-white mb-3 group-hover:text-[#3ECF8E] transition-colors duration-300">
                {heroPost.title}
              </h2>
              <p class="text-white/60 text-sm md:text-base leading-relaxed line-clamp-2 max-w-2xl mb-4">
                {heroPost.excerpt}
              </p>
              <div class="flex items-center gap-3 text-xs text-white/45 font-medium">
                <span class="text-[#3ECF8E]">{heroPost.authorName || 'Zaid'}</span>
                <span class="w-1 h-1 rounded-full bg-white/25"></span>
                <span>{fmtDate(heroPost.publishedAt)}</span>
              </div>
            </div>
          </a>

          <!-- Side featured cards -->
          <div class="flex flex-col gap-5">
            {sidePosts.map((post: any) => (
              <a href={`/${post.slug}`}
                 class="group relative flex-1 rounded-3xl overflow-hidden
                        border border-white/[0.07] hover:border-[#3ECF8E]/35
                        min-h-[210px] flex items-end
                        transition-all duration-500 hover:-translate-y-1">
                {post.mainImage ? (
                  <img
                    src={urlFor(post.mainImage).width(640).url()}
                    alt={post.mainImage.alt || post.title}
                    class="absolute inset-0 w-full h-full object-cover
                           transition-transform duration-700 group-hover:scale-105"
                  />
                ) : (
                  <div class="absolute inset-0 bg-gradient-to-br from-[#141614] to-[#0E100E]"></div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-[#0B0C0B]/95 via-[#0B0C0B]/35 to-transparent"></div>

                <div class="relative z-10 p-6 w-full">
                  {post.categories?.[0] && (
                    <span class="inline-block mb-2.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold
                                 uppercase tracking-[0.15em] border border-white/20 text-white/70">
                      {post.categories[0]}
                    </span>
                  )}
                  <h3 class="font-heading font-bold text-lg leading-snug text-white
                             group-hover:text-[#3ECF8E] transition-colors duration-300 line-clamp-2">
                    {post.title}
                  </h3>
                  <div class="mt-2 text-xs text-white/45">{fmtDate(post.publishedAt)}</div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- ── Main grid + sidebar ── -->
      <div class="grid lg:grid-cols-[1fr_320px] gap-10 items-start">

        <!-- Article grid -->
        <div>
          <div class="flex items-center gap-4 mb-8">
            <h2 class="font-heading font-bold text-lg text-white shrink-0">
              {isFirstPage ? 'Artikel Lainnya' : `Artikel — Halaman ${page.currentPage}`}
            </h2>
            <div class="h-px flex-1 bg-white/[0.07]"></div>
          </div>

          <div class="grid sm:grid-cols-2 gap-6">
            {gridPosts.map((post: any) => (
              <article class="group card-premium overflow-hidden flex flex-col">
                <a href={`/${post.slug}`} class="block relative aspect-[16/10] overflow-hidden">
                  {post.mainImage ? (
                    <img
                      src={urlFor(post.mainImage).width(640).url()}
                      alt={post.mainImage.alt || post.title}
                      class="absolute inset-0 w-full h-full object-cover
                             transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <div class="absolute inset-0 bg-gradient-to-br from-[#141614] to-[#0E100E]
                                flex items-center justify-center">
                      <span class="font-heading font-extrabold text-4xl text-white/10">Z</span>
                    </div>
                  )}
                </a>

                <div class="p-6 flex flex-col flex-1">
                  <div class="flex items-center gap-2 mb-3 flex-wrap">
                    {post.categories?.slice(0, 2).map((cat: string) => (
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-[0.12em]
                                   text-[#3ECF8E] bg-[#3ECF8E]/[0.08] border border-[#3ECF8E]/20">
                        {cat}
                      </span>
                    ))}
                  </div>

                  <a href={`/${post.slug}`}>
                    <h3 class="font-heading font-bold text-lg leading-snug text-white mb-2
                               group-hover:text-[#3ECF8E] transition-colors duration-300 line-clamp-2">
                      {post.title}
                    </h3>
                  </a>

                  <p class="text-white/45 text-sm leading-relaxed line-clamp-2 flex-1">
                    {post.excerpt}
                  </p>

                  <div class="mt-4 pt-4 border-t border-white/[0.06]
                              flex items-center justify-between text-xs text-white/45">
                    <span class="text-white/60 font-medium">{post.authorName || 'Zaid'}</span>
                    <span>{fmtDate(post.publishedAt)}</span>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <!-- Page 1: single "view more" button; archive pages: full pagination -->
          {isFirstPage && page.url.next && (
            <div class="mt-14 flex justify-center border-t border-white/[0.06] pt-10">
              <a href={page.url.next} class="btn-ghost px-8">
                Lihat Artikel Lainnya
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          )}

          {!isFirstPage && page.lastPage > 1 && (
            <div class="mt-14 flex justify-center items-center gap-4 border-t border-white/[0.06] pt-10">
              {page.url.prev && (
                <a href={page.url.prev} class="btn-ghost px-6 py-2.5 text-xs">← Sebelumnya</a>
              )}
              <span class="font-heading text-white/45 text-sm px-4">
                {page.currentPage} / {page.lastPage}
              </span>
              {page.url.next && (
                <a href={page.url.next} class="btn-premium px-6 py-2.5 text-xs">Berikutnya →</a>
              )}
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="space-y-6 lg:sticky lg:top-24">

          <!-- Popular / latest posts -->
          <div class="card-premium p-6">
            <div class="flex items-center gap-3 mb-5">
              <span class="w-1.5 h-5 rounded-full bg-[#3ECF8E]"></span>
              <h3 class="font-heading font-bold text-white text-base">Paling Baru</h3>
            </div>
            <div class="space-y-4">
              {sidebarPosts.map((post: any, i: number) => (
                <a href={`/${post.slug}`} class="group flex items-start gap-4">
                  <span class="font-heading font-extrabold text-2xl leading-none w-8 shrink-0
                               text-white/15 group-hover:text-[#3ECF8E] transition-colors duration-300">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0">
                    <h4 class="text-sm font-semibold text-white/80 leading-snug line-clamp-2
                               group-hover:text-white transition-colors duration-300">
                      {post.title}
                    </h4>
                    <span class="text-xs text-white/40 mt-1 block">{fmtDate(post.publishedAt)}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- Categories -->
          {allCategories.length > 0 && (
            <div class="card-premium p-6">
              <div class="flex items-center gap-3 mb-5">
                <span class="w-1.5 h-5 rounded-full bg-[#A3E635]"></span>
                <h3 class="font-heading font-bold text-white text-base">Kategori</h3>
              </div>
              <div class="flex flex-wrap gap-2">
                {allCategories.map((cat: string) => (
                  <span class="px-3 py-1.5 rounded-full text-xs font-medium
                               border border-white/[0.1] text-white/60
                               hover:border-[#3ECF8E]/40 hover:text-[#3ECF8E] transition-colors duration-300">
                    {cat}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- CTA widget -->
          <div class="relative rounded-3xl overflow-hidden border border-[#3ECF8E]/25
                      bg-gradient-to-b from-[#10160F] to-[#0B0C0B] p-7 text-center">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[280px] h-[160px]
                        bg-[radial-gradient(ellipse,rgba(62,207,142,0.15)_0%,transparent_65%)]
                        pointer-events-none"></div>
            <div class="relative z-10">
              <h3 class="font-heading font-extrabold text-xl text-white leading-tight mb-2">
                Butuh website untuk <span class="word-accent">bisnismu?</span>
              </h3>
              <p class="text-white/50 text-sm leading-relaxed mb-5">
                Konsultasi gratis, respon cepat via WhatsApp.
              </p>
              <a href="https://wa.me/6281274203815" class="btn-premium w-full text-sm py-3">
                Konsultasi Gratis
              </a>
            </div>
          </div>

        </aside>
      </div>

    </div>
  </main>

</Layout>
