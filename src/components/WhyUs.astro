---
const features = [
  {
    title: 'PERFORMA TINGGI',
    desc: 'Website dibangun dengan Astro, menghasilkan skor kecepatan 100/100 di Google Lighthouse tanpa kompromi.',
    chip: 'âš¡ Top Score',
    chipStyle: 'dark',
  },
  {
    title: 'SEO OPTIMIZED',
    desc: 'Struktur metadata rapi & JSON-LD, memastikan bisnis Anda nangkring di halaman pertama Google.',
    chip: 'ðŸ” SEO',
    chipStyle: 'blue',
  },
  {
    title: 'MODERN CMS',
    desc: 'Kelola konten artikel dan layanan Anda sendiri secepat kilat melalui dashboard Sanity CMS.',
    chip: 'ðŸ›  CMS',
    chipStyle: 'purple',
  },
  {
    title: 'CLOUDFLARE EDGE',
    desc: 'Proteksi tingkat dewa dari serangan siber dengan infrastruktur server Global Cloudflare.',
    chip: 'ðŸ›¡ CDN',
    chipStyle: 'blue',
  },
];

const chipClass = {
  dark:   'bg-brand-primary/20 text-[#818cff]',
  blue:   'bg-brand-primary/8 text-brand-primary',
  purple: 'bg-brand-secondary/8 text-brand-secondary',
};

const cardStyle = [
  // Card 01 â€” dark hero card
  'wu-card-dark',
  // Card 02 â€” pure white
  'bg-white border border-brand-primary/10 hover:border-brand-primary/30',
  // Card 03 â€” soft purple tint
  'bg-[#f9f7ff] border border-brand-secondary/12 hover:border-brand-secondary/30',
  // Card 04 â€” soft blue tint
  'bg-[#f7f8ff] border border-brand-primary/8 hover:border-brand-primary/25',
];
---

<!-- LIGHT section â€” pecah ritme dark-dark-dark -->
<section id="about" class="py-40 bg-[#f4f4f8] overflow-hidden relative">

  <!-- Decorative blobs: samar, bukan bold -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px]
              bg-[radial-gradient(ellipse,rgba(50,69,255,0.07)_0%,transparent_70%)]
              pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px]
              bg-[radial-gradient(ellipse,rgba(188,82,238,0.05)_0%,transparent_70%)]
              pointer-events-none"></div>

  <!-- Top edge: transisi dari section gelap sebelumnya -->
  <div class="absolute top-0 left-0 right-0 h-24
              bg-gradient-to-b from-[#080d20] to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="flex flex-col lg:flex-row gap-16 xl:gap-24 items-center">

      <!-- LEFT: Heading & intro -->
      <div class="lg:w-2/5">

        <!-- Label -->
        <div class="label-brand mb-6">Value Proposition</div>

        <!-- Heading -->
        <h2 class="text-5xl md:text-6xl xl:text-7xl leading-[0.88] mb-6 text-[#0a0a14]">
          MENGAPA<br/>
          HARUS<br/>
          <span class="text-gradient-static">ZAIDLY?</span>
        </h2>

        <!-- Accent bar -->
        <div class="h-[3px] w-16 rounded-full mb-8"
             style="background: linear-gradient(90deg, #3245FF, #BC52EE);"></div>

        <p class="text-[#6b6b80] font-medium text-base md:text-lg leading-relaxed max-w-sm">
          Kami tidak hanya membuat website kaku. Kami membangun
          <span class="text-[#0a0a14] font-bold">identitas digital</span>
          yang dirancang khusus untuk konversi dan menghasilkan uang.
        </p>

        <!-- Stats kecil -->
        <div class="mt-12 flex gap-8">
          {[['100', 'Lighthouse Score'], ['#1', 'Google Rank'], ['24/7', 'Support']].map(([val, lbl]) => (
            <div>
              <div class="text-2xl font-black text-[#0a0a14] leading-none mb-0.5"
                   style="background: linear-gradient(135deg,#3245FF,#BC52EE); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                {val}
              </div>
              <div class="text-[10px] text-[#9898aa] font-bold uppercase tracking-widest">{lbl}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- RIGHT: Feature cards 2x2 -->
      <div class="lg:w-3/5 grid sm:grid-cols-2 gap-5">
        {features.map((f, i) => (
          <div class={`wu-card group relative rounded-[28px] p-9 overflow-hidden
                       transition-all duration-500 hover:-translate-y-2
                       ${cardStyle[i]}`}>

            <!-- Large background number -->
            <div class={`absolute top-4 right-5 text-[64px] font-black leading-none select-none
                         ${i === 0 ? 'text-white/[0.06]' : 'text-brand-primary/[0.06]'}`}>
              0{i + 1}
            </div>

            <!-- Chip -->
            <div class={`wu-chip inline-flex items-center gap-1.5
                         px-3 py-1.5 rounded-full mb-5
                         text-[9px] font-black uppercase tracking-[0.25em]
                         ${i === 0 ? chipClass.dark : chipClass[f.chipStyle as keyof typeof chipClass]}`}>
              {f.chip}
            </div>

            <!-- Title -->
            <h3 class={`text-lg font-black uppercase tracking-tight mb-3
                         transition-transform duration-300 group-hover:translate-x-1
                         ${i === 0 ? 'text-white' : 'text-[#0a0a14]'}`}>
              {f.title}
            </h3>

            <!-- Desc -->
            <p class={`text-sm leading-relaxed font-medium
                        ${i === 0 ? 'text-white/50' : 'text-[#7878a0] group-hover:text-[#4a4a6a]'}
                        transition-colors duration-300`}>
              {f.desc}
            </p>

            <!-- Bottom accent bar -->
            <div class={`absolute bottom-0 left-0 h-[2px] rounded-r-full
                          transition-all duration-700
                          ${i === 0 ? 'w-full' : 'w-8 group-hover:w-full'}`}
                 style="background: linear-gradient(90deg, #3245FF, #BC52EE);">
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  /* Dark hero card â€” card pertama */
  .wu-card-dark {
    background: linear-gradient(145deg, #0e1530 0%, #15122a 100%);
    border: 1px solid rgba(50, 69, 255, 0.2);
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .wu-card-dark:hover {
    border-color: rgba(50, 69, 255, 0.4);
    box-shadow:
      0 30px 70px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(50, 69, 255, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }

  /* Chip utility â€” override font-heading global */
  .wu-chip {
    font-style: normal !important;
  }
</style>