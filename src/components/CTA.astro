<section class="py-24 relative overflow-hidden bg-[#0B0C0B]">

  <div class="max-w-5xl mx-auto px-6 relative z-10">

    <div class="relative rounded-[32px] overflow-hidden border border-[#3ECF8E]/20
                bg-gradient-to-b from-[#10160F] to-[#0B0C0B] px-8 py-16 md:px-16 md:py-20 text-center">

      <!-- Glow -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px]
                  bg-[radial-gradient(ellipse,rgba(62,207,142,0.14)_0%,transparent_65%)]
                  pointer-events-none"></div>

      <!-- Dot grid -->
      <div class="absolute inset-0 pointer-events-none opacity-30"
           style="background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 24px 24px;
                  mask-image: radial-gradient(ellipse 70% 70% at 50% 0%, black 20%, transparent 70%);
                  -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 0%, black 20%, transparent 70%);"></div>

      <div class="relative z-10">
        <span class="section-label mx-auto">Mulai Sekarang</span>

        <h2 class="font-heading font-extrabold text-4xl md:text-5xl leading-[1.08] tracking-tight text-white mb-6">
          Siap bikin bisnis Anda
          <span class="word-accent">go digital?</span>
        </h2>

        <p class="text-white/50 max-w-xl mx-auto mb-10 leading-relaxed">
          Jangan biarkan kompetitor mendahului Anda. Konsultasikan kebutuhan website UMKM Anda sekarang juga. Gratis tanpa dipungut biaya!
        </p>

        <div class="flex flex-wrap justify-center gap-4">
          <a href="https://wa.me/6281274203815"
             class="group btn-premium gap-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
