<section class="py-24 relative overflow-hidden">

  <!-- Gradient background -->
  <div class="absolute inset-0"
       style="background: linear-gradient(135deg, #07091d 0%, #0a0614 40%, #07091d 100%);"></div>

  <!-- Radial glows -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px]
                bg-[radial-gradient(ellipse,rgba(50,69,255,0.15)_0%,transparent_65%)]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[250px]
                bg-[radial-gradient(ellipse,rgba(188,82,238,0.12)_0%,transparent_65%)]"></div>
  </div>

  <!-- Top/bottom border lines -->
  <div class="absolute top-0 left-0 right-0 h-[1px]
              bg-gradient-to-r from-transparent via-[#3245FF]/40 to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 h-[1px]
              bg-gradient-to-r from-transparent via-[#BC52EE]/30 to-transparent"></div>

  <div class="max-w-4xl mx-auto px-6 relative z-10 text-center">

    <span class="section-label mx-auto">Mulai Sekarang</span>

    <h2 class="font-heading font-black uppercase text-4xl md:text-6xl leading-[0.88] tracking-tighter text-white mb-6">
      Siap Bikin Bisnis Anda
      <span class="text-gradient"> Go Digital?</span>
    </h2>

    <p class="text-white/40 max-w-xl mx-auto mb-10 leading-relaxed">
      Jangan biarkan kompetitor mendahului Anda. Konsultasikan kebutuhan website UMKM Anda sekarang juga. Gratis tanpa dipungut biaya!
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a href="https://wa.me/6281274203815"
         class="group btn-premium gap-3">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM11.997 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.978-1.402A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10S17.52 2 11.997 2z"/>
        </svg>
        Hubungi Via WhatsApp
      </a>
      <a href="/portfolio" class="btn-ghost">
        Lihat Portfolio
