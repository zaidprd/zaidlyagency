---
import { Image } from 'astro:assets';
import heroImage from '../assets/placeholder-hero.webp';

const features = [
  'Jangkau pelanggan ke seluruh Indonesia secara digital.',
  'Keamanan High-Level + Support Maintenance 24/7.',
];

const stats = [
  { value: '100+', label: 'Proyek Selesai' },
  { value: '98%',  label: 'Klien Puas' },
  { value: '3x',   label: 'Rata-rata ROI' },
];
---

<section class="hero-section relative pt-16 md:pt-28 pb-24 md:pb-40 overflow-hidden">

  <!-- Background -->
  <div class="absolute inset-0 bg-[#0B0C0B]"></div>

  <!-- Subtle dot grid -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.35]"
       style="background-image: radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1px); background-size: 28px 28px;
              mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 75%);
              -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 75%);"></div>

  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[480px]
                bg-[radial-gradient(ellipse,rgba(62,207,142,0.1)_0%,transparent_65%)]"></div>
  </div>

  <div class="absolute inset-0 grain-overlay"></div>

  <!-- Content -->
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 xl:gap-24 items-center">

      <!-- Left: Text -->
      <div class="text-white order-last lg:order-first">

        <div class="inline-flex items-center gap-2.5 px-4 py-2 mb-8
                    bg-[#3ECF8E]/[0.07] border border-[#3ECF8E]/20 rounded-full backdrop-blur-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#3ECF8E] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#3ECF8E]"></span>
          </span>
          <span class="text-[#3ECF8E] font-semibold text-xs tracking-wide">
            Digital Agency untuk UMKM Indonesia
          </span>
        </div>

        <h1 class="font-heading font-extrabold leading-[1.04] tracking-tight mb-6
                   text-[2.75rem] md:text-6xl lg:text-[4.25rem] text-white">
          Fokus bisnis,<br />
          <span class="word-accent">websitenya</span> biar<br />
          kami urus.
        </h1>

        <p class="text-white/55 text-base md:text-lg max-w-md leading-relaxed mb-8">
          Tingkatkan skala bisnis Anda dengan website kustom yang cepat,
          responsif, dan didesain untuk konversi maksimal.
        </p>

        <ul class="space-y-3 mb-10">
          {features.map(item => (
            <li class="flex items-start gap-3 group">
              <div class="mt-0.5 w-5 h-5 rounded-full bg-[#3ECF8E]/12 border border-[#3ECF8E]/30
                          flex items-center justify-center shrink-0">
                <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                  <path d="M1 4l2.5 2.5L9 1" stroke="#3ECF8E" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="text-white/55 text-sm group-hover:text-white/85 transition-colors leading-relaxed">
                {item}
              </span>
            </li>
          ))}
        </ul>

        <div class="flex flex-col sm:flex-row gap-5 items-start sm:items-center">
          <a href="https://wa.me/6281274203815" class="btn-premium group">
            <span>Mulai Proyek Sekarang</span>
            <svg class="transition-transform duration-300 group-hover:translate-x-1"
                 width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>

          <div class="flex items-center gap-3">
            <div class="flex -space-x-2">
              {['#3ECF8E', '#A3E635', '#2BB673'].map((c) => (
                <div class="w-7 h-7 rounded-full border-2 border-[#0B0C0B]" style={`background: ${c};`}></div>
              ))}
            </div>
            <div>
              <div class="text-xs font-bold text-white">Slot terbatas</div>
              <div class="text-xs text-white/40">Hanya 5 slot bulan ini</div>
            </div>
          </div>
        </div>

        <div class="mt-14 pt-10 border-t border-white/[0.07]">
          <div class="grid grid-cols-3 gap-6">
            {stats.map((s, i) => (
              <div class="relative">
                {i < stats.length - 1 && (
                  <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[1px] h-8 bg-white/10"></div>
                )}
                <div class="text-2xl md:text-3xl font-extrabold text-white mb-0.5">
                  {s.value}
                </div>
                <div class="text-xs text-white/40 font-medium">
                  {s.label}
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- Right: Image Frame -->
      <div class="relative group flex justify-center lg:justify-end">

        <div class="absolute inset-[10%] rounded-full
                    bg-[radial-gradient(ellipse,rgba(62,207,142,0.18)_0%,transparent_75%)]
                    blur-[60px] group-hover:scale-110 transition-transform duration-1000"></div>

        <div class="hero-frame relative z-10 w-full max-w-lg">

          <div class="relative rounded-[24px] border border-white/10 bg-[#101210] overflow-hidden
                      shadow-[0_40px_80px_rgba(0,0,0,0.5)]">

            <!-- Browser top bar -->
            <div class="flex items-center justify-between px-5 py-3
                        border-b border-white/[0.06] bg-[#151715]">
              <div class="flex gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-[#febc2e]"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-[#28c840]"></div>
              </div>
              <div class="flex-1 mx-4">
                <div class="bg-[#0B0C0B] border border-white/[0.07] rounded-lg px-3 py-1 text-center">
                  <span class="text-[10px] text-white/35 font-mono">zaidly.id/project</span>
                </div>
              </div>
              <div class="flex gap-1.5 opacity-40">
                <div class="w-4 h-4 rounded bg-white/10"></div>
                <div class="w-4 h-4 rounded bg-white/10"></div>
              </div>
            </div>

            <div class="relative overflow-hidden">
              <Image
                src={heroImage}
                alt="Zaidly Agency Premium Preview"
                width={800}
                height={580}
                class="w-full h-auto transform transition-transform duration-1000 group-hover:scale-[1.03]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#101210]/60 via-transparent to-transparent"></div>
            </div>

            <div class="px-5 py-4 flex items-center justify-between border-t border-white/[0.06]">
              <div class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 rounded-full bg-[#3ECF8E] animate-pulse"></div>
                <span class="text-[11px] text-white/45 font-medium">Live Preview</span>
              </div>
              <span class="text-[11px] font-bold text-[#3ECF8E]">
                Zaidly Edition
              </span>
            </div>
          </div>

          <!-- Floating badge: Performance -->
          <div class="absolute -top-5 -right-5 z-20
                      bg-[#151715] border border-white/10 rounded-2xl px-4 py-3
                      shadow-[0_20px_40px_rgba(0,0,0,0.5)] backdrop-blur-sm
                      hover:-translate-y-1 transition-transform duration-300">
            <div class="text-xl font-extrabold text-white leading-none">100</div>
            <div class="text-[10px] text-[#3ECF8E] font-semibold mt-0.5">Performance</div>
          </div>

          <!-- Floating badge: SEO -->
          <div class="absolute -bottom-5 -left-5 z-20
                      bg-[#151715] border border-white/10 rounded-2xl px-4 py-3
                      shadow-[0_20px_40px_rgba(0,0,0,0.5)] backdrop-blur-sm
                      hover:-translate-y-1 transition-transform duration-300">
            <div class="text-xl font-extrabold text-[#3ECF8E] leading-none">#1</div>
            <div class="text-[10px] text-white/45 font-semibold mt-0.5">Google Rank</div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Bottom fade -->
  <div class="absolute bottom-0 left-0 right-0 h-32
              bg-gradient-to-t from-[#0B0C0B] to-transparent pointer-events-none"></div>

</section>

<style>
  .hero-frame {
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .group:hover .hero-frame {
    transform: translateY(-6px);
  }
</style>
