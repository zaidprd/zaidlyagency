---
/* PromoBar Component - Zaidly Agency
   Style: Dark Premium / Teal Accent
   Behavior: Scroll-away (tidak sticky)
*/
---

<div class="promo-bar relative z-[130] border-b border-white/8 px-6 py-3 text-white">
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute left-1/2 top-1/2 h-24 w-[420px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl bg-[radial-gradient(circle,rgba(0,206,209,0.12)_0%,transparent_70%)]"></div>
  </div>

  <div class="relative mx-auto flex max-w-7xl flex-col items-center justify-center gap-4 md:flex-row">
    <div class="flex items-center gap-3 text-center md:text-left">
      <span class="relative flex h-2.5 w-2.5 shrink-0">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#00ced1]/70"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#00ced1] shadow-[0_0_12px_rgba(0,206,209,0.65)]"></span>
      </span>

      <span class="text-[11px] font-extrabold uppercase tracking-[0.16em] text-white/75 md:text-xs">
        Promo April:
        <span class="text-[#00ced1]"> Diskon 10%</span>
        untuk UMKM & Startup Lokal
      </span>
    </div>

    <a
      href="https://wa.me/6281274203815?text=Halo%20Zaidly,%20saya%20ingin%20konsultasi%20gratis"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded-full border border-[#00ced1]/30 bg-[linear-gradient(135deg,#00ced1,#0891b2)] px-6 py-2 text-[10px] font-black uppercase tracking-[0.18em] text-[#061014] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_10px_30px_rgba(0,206,209,0.25)] active:scale-[0.98] md:text-[11px]"
    >
      Konsultasi Gratis
    </a>
  </div>
</div>

<style>
  .promo-bar {
    background:
      linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)),
      rgba(6, 7, 10, 0.96);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.03),
      0 10px 30px rgba(0,0,0,0.18);
    font-style: normal;
  }
</style>