---
const year = new Date().getFullYear();

const services = [
  { label: 'Landing Page',     href: '#services' },
  { label: 'Website UMKM',     href: '#services' },
  { label: 'Company Profile',  href: '#services' },
  { label: 'Jasa Artikel SEO', href: '#services' },
];

const nav = [
  { label: 'Home',      href: '/' },
  { label: 'Blog',      href: '/blog' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Kontak',    href: '/contact' },
];

const socials = [
  { label: 'IG', href: 'https://instagram.com/zaidly.agency' },
  { label: 'in', href: 'https://linkedin.com' },
  { label: 'WA', href: 'https://wa.me/6281274203815' },
];
---

<footer class="ft relative overflow-hidden border-t border-white/[0.06]">

  <div class="absolute inset-0 bg-[#0A0B0A]"></div>

  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[250px]
              bg-[radial-gradient(ellipse_at_50%_0%,rgba(62,207,142,0.06)_0%,transparent_70%)]
              pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 py-20 relative z-10">

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16 items-start mb-16">

      <!-- Brand col -->
      <div class="lg:col-span-2 space-y-6">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center
                      font-extrabold text-lg text-[#07100B] bg-[#3ECF8E]
                      shadow-[0_4px_16px_rgba(62,207,142,0.3)]">
            Z
          </div>
          <div class="text-[22px] font-heading font-extrabold tracking-tight text-white leading-none">
            zaidly<span class="text-[#3ECF8E]">.</span>
          </div>
        </div>

        <p class="text-white/45 text-sm leading-relaxed max-w-xs">
          Partner strategis
          <span class="text-white/80 font-semibold">transformasi digital</span>
          untuk UMKM & perusahaan dengan teknologi web modern kelas dunia.
        </p>

        <div class="flex gap-2">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener"
               class="w-9 h-9 rounded-lg border border-white/[0.08]
                      bg-white/[0.03] flex items-center justify-center
                      text-[10px] font-bold text-white/45
                      transition-all duration-300 hover:border-[#3ECF8E]/45
                      hover:text-[#3ECF8E] hover:bg-[#3ECF8E]/[0.08] hover:-translate-y-0.5">
              {s.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Layanan col -->
      <div class="space-y-5">
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-[#3ECF8E]">
          Layanan
        </h4>
        <nav class="flex flex-col gap-3.5">
          {services.map((s) => (
            <a href={s.href}
               class="group inline-flex items-center gap-2 text-sm font-medium
                      text-white/45 hover:text-white transition-colors duration-300">
              <span class="w-0 h-[1px] bg-[#3ECF8E] rounded-full
                           group-hover:w-3 transition-all duration-300"></span>
              {s.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Kontak col -->
      <div class="space-y-5">
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-[#3ECF8E]">
          Hubungi Kami
        </h4>
        <div class="flex flex-col gap-3">
          <p class="text-white/60 text-sm">
            hello@zaidly.com
          </p>
          <p class="text-white/60 text-sm">
            Jakarta, Indonesia
          </p>
          <a href="tel:+6281274203815"
             class="text-sm font-bold text-[#3ECF8E] hover:opacity-80 transition-opacity">
            +62 812 7420 3815
          </a>
        </div>
      </div>

    </div>

    <div class="pt-8 border-t border-white/[0.06]
                flex flex-col md:flex-row justify-between items-center gap-5">

      <div class="text-xs text-white/30">
        &copy; {year} Zaidly Agency.
        <span class="text-white/40 ml-1">All rights reserved.</span>
      </div>

      <div class="flex gap-8 text-xs text-white/30">
        <a href="#" class="hover:text-white/70 transition-colors duration-300">Privacy Policy</a>
        <a href="#" class="hover:text-white/70 transition-colors duration-300">Terms of Service</a>
      </div>

    </div>
  </div>
</footer>
