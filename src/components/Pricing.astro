---
const plans = [
  {
    name: 'Basic',
    price: 'IDR 588.000',
    period: '/ setahun',
    renewal: 'IDR 500.000',
    freeUpdate: '1 Halaman',
    featured: false,
    features: [
      { label: 'Halaman Website',   value: '5 Halaman' },
      { label: 'Waktu Pengerjaan',  value: 'Max 5 Hari Kerja' },
      { label: 'Free Domain',       value: '.com', highlight: true },
      { label: 'Free Hosting',      value: 'Entry 1GB' },
      { label: 'Email Bisnis & SSL', value: 'Gratis', highlight: true },
      { label: 'Optimasi SEO',      value: '3 Artikel SEO' },
      { label: 'Image Editing',     value: '5 Image + 1 Logo' },
    ],
    waText: 'Halo%20Zaid,%20saya%20tertarik%20Paket%20Basic',
  },
  {
    name: 'Pro',
    price: 'IDR 1.000.000',
    period: '/ setahun',
    renewal: 'IDR 700.000',
    freeUpdate: '2 Halaman',
    featured: true,
    features: [
      { label: 'Halaman Website',   value: '5 Halaman' },
      { label: 'Waktu Pengerjaan',  value: 'Max 6 Hari Kerja' },
      { label: 'Free Domain',       value: '.com', highlight: true },
      { label: 'Free Hosting',      value: 'Unlimited Small' },
      { label: 'Email Bisnis & SSL', value: 'Gratis', highlight: true },
      { label: 'Optimasi SEO',      value: '6 Artikel SEO' },
      { label: 'Image Editing',     value: '10 Image + 1 Logo' },
    ],
    waText: 'Halo%20Zaid,%20saya%20tertarik%20Paket%20Pro',
  },
  {
    name: 'Business',
    price: 'IDR 2.588.000',
    period: '/ setahun',
    renewal: 'IDR 1.000.000',
    freeUpdate: '3 Halaman',
    featured: false,
    features: [
      { label: 'Halaman Website',   value: '5 Halaman' },
      { label: 'Waktu Pengerjaan',  value: 'Max 6 Hari Kerja' },
      { label: 'Free Domain',       value: '.com', highlight: true },
      { label: 'Free Hosting',      value: 'Unlimited Small' },
      { label: 'Email Bisnis & SSL', value: 'Gratis', highlight: true },
      { label: 'Optimasi SEO',      value: '12 Artikel SEO' },
      { label: 'Image Editing',     value: '15 Image + 1 Logo' },
    ],
    waText: 'Halo%20Zaid,%20saya%20tertarik%20Paket%20Business',
  },
];
---

<section id="pricing" class="py-28 bg-[#0E100E] relative overflow-hidden">

  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[500px]
              bg-[radial-gradient(ellipse,rgba(62,207,142,0.04)_0%,transparent_70%)]
              pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">

    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="section-label">Paket Investasi Digital</span>
      <h2 class="font-heading font-extrabold text-4xl md:text-[2.75rem] leading-[1.1] tracking-tight text-white mb-6">
        Pilihan paket <span class="word-accent">terbaik</span> untuk bisnis Anda.
      </h2>
      <p class="text-white/50 text-sm leading-relaxed">
        Harga transparan untuk pembuatan website profesional berbasis WordPress Drag & Drop.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
      {plans.map((plan) => (
        <div class={`relative flex flex-col rounded-3xl p-8 transition-all duration-500
          ${plan.featured
            ? 'border border-[#3ECF8E]/45 bg-[#121813] shadow-[0_0_80px_rgba(62,207,142,0.12)] md:scale-105 z-10'
            : 'card-premium'}`}>

          {plan.featured && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2
                        px-4 py-1.5 rounded-full text-[11px] font-bold uppercase tracking-[0.15em]
                        text-[#07100B] bg-[#3ECF8E]">
              Paling Populer
            </div>
          )}

          <h3 class={`font-heading font-bold text-xl mb-4 ${plan.featured ? 'text-[#3ECF8E]' : 'text-white/80'}`}>
            {plan.name}
          </h3>

          <div class="mb-1">
            <span class="text-3xl font-heading font-extrabold text-white tracking-tight">{plan.price}</span>
          </div>
          <p class="text-white/40 text-xs font-medium mb-8">{plan.period}</p>

          <ul class="space-y-4 mb-8 pt-6 border-t border-white/[0.06] flex-1">
            {plan.features.map((f) => (
              <li class="flex items-center justify-between gap-3">
                <span class="text-xs text-white/40 font-medium">{f.label}</span>
                <span class={`text-sm font-semibold text-right ${f.highlight ? 'text-[#3ECF8E]' : 'text-white/85'}`}>{f.value}</span>
              </li>
            ))}
            <li class="flex items-center justify-between gap-3 pt-4 border-t border-white/[0.06]">
              <span class="text-xs text-white/40 font-medium">Biaya Perpanjangan</span>
              <span class="text-sm font-semibold text-white/85 text-right">{plan.renewal}</span>
            </li>
          </ul>

          <a href={`https://wa.me/6281274203815?text=${plan.waText}`}
             target="_blank"
             class={`block text-center py-3.5 rounded-full font-bold text-sm
                    transition-all duration-300 hover:-translate-y-0.5 active:scale-95
                    ${plan.featured
                      ? 'bg-[#3ECF8E] text-[#07100B] shadow-[0_8px_24px_rgba(62,207,142,0.3)] hover:bg-[#4ADF9D]'
                      : 'border border-white/15 text-white hover:border-[#3ECF8E]/50 hover:text-[#3ECF8E]'}`}>
            Pilih Paket {plan.name}
          </a>

        </div>
      ))}
    </div>

    <!-- Free update comparison bar -->
    <div class="mt-16 rounded-2xl border border-white/[0.07] bg-[#141614] overflow-hidden">
      <div class="grid grid-cols-3 divide-x divide-white/[0.06]">
        {plans.map((plan) => (
          <div class="p-6 text-center">
            <span class="text-xs text-white/40 font-medium block mb-2">{plan.name}</span>
            <span class="font-heading font-bold text-white text-sm">Free Update {plan.freeUpdate}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
