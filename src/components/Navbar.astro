---
const links = [
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Apps',      href: '/apps' },
  { label: 'Blog',      href: '/blog' },
  { label: 'Contact',   href: '/contact' },
];
---

<nav class="navbar sticky top-0 z-[100]">

  <!-- Glassmorphism base -->
  <div class="navbar-bg absolute inset-0"></div>

  <!-- Bottom shimmer line -->
  <div class="absolute bottom-0 left-0 right-0 h-[1px]
              bg-gradient-to-r from-transparent via-[#3245FF]/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-6 h-[72px] flex items-center justify-between relative z-10">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group cursor-pointer no-underline">
      <div class="w-9 h-9 rounded-[10px] flex items-center justify-center
                  font-black text-lg text-white
                  transition-transform duration-500 group-hover:rotate-12"
           style="background: linear-gradient(135deg, #3245FF, #BC52EE);
                  box-shadow: 0 4px 16px rgba(50,69,255,0.4);">
        Z
      </div>
      <div class="text-[20px] font-black uppercase tracking-tighter text-white leading-none">
        ZAIDLY<span class="text-gradient-static">.</span>
      </div>
    </a>

    <!-- Nav links (desktop only) -->
    <ul class="hidden md:flex items-center gap-9 list-none m-0 p-0">
      {links.map((l) => (
        <li>
          <a href={l.href}
             class="nav-link relative text-[10px] font-black uppercase tracking-[0.3em]
                    text-white/40 hover:text-white transition-colors duration-300 no-underline">
            {l.label}
            <span class="nav-underline absolute -bottom-1 left-0 h-[1.5px] w-0
                         transition-all duration-300 rounded-full"
                  style="background: linear-gradient(90deg, #3245FF, #BC52EE);"></span>
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA button (desktop only) -->
    <a href="https://wa.me/6281274203815"
       class="nav-cta hidden md:inline-flex items-center gap-2
              px-6 py-[10px] rounded-[10px]
              text-[10px] font-black uppercase tracking-[0.2em] text-white
              transition-all duration-300 hover:-translate-y-0.5 active:scale-95">
      Hubungi WA
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="shrink-0">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM11.997 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.978-1.402A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10S17.52 2 11.997 2z"/>
      </svg>
    </a>

    <!-- Hamburger button (mobile only) -->
    <button
      id="nav-hamburger"
      class="md:hidden flex flex-col justify-center items-center gap-[5px]
             w-11 h-11 rounded-[10px] transition-colors duration-200
             hover:bg-white/5 active:bg-white/10"
      aria-label="Toggle Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span id="ham-line1" class="w-5 h-[2px] bg-white/70 rounded-full block transition-all duration-300"></span>
      <span id="ham-line2" class="w-5 h-[2px] bg-white/70 rounded-full block transition-all duration-300"></span>
      <span id="ham-line3" class="w-3 h-[2px] bg-white/70 rounded-full block transition-all duration-300"></span>
    </button>

  </div>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    class="md:hidden mobile-menu-panel"
    aria-hidden="true"
  >
    <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col gap-1">
      {links.map((l) => (
        <a
          href={l.href}
          class="mobile-nav-link block px-4 py-4 rounded-[12px]
                 text-[11px] font-black uppercase tracking-[0.3em]
                 text-white/50 hover:text-white hover:bg-white/[0.04]
                 transition-all duration-200 no-underline"
        >
          {l.label}
        </a>
      ))}

      <!-- CTA in mobile menu -->
      <div class="mt-4 pt-4 border-t border-white/[0.06]">
        <a
          href="https://wa.me/6281274203815"
          class="nav-cta flex items-center justify-center gap-2
                 w-full py-4 rounded-[12px]
                 text-[11px] font-black uppercase tracking-[0.2em] text-white
                 transition-all duration-300 active:scale-95"
        >
          Hubungi via WhatsApp
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM11.997 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.978-1.402A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10S17.52 2 11.997 2z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

</nav>

<!-- Backdrop overlay for mobile menu -->
<div id="nav-backdrop" class="nav-backdrop"></div>

<style>
  @reference "../styles/global.css";

  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .navbar-bg {
    background: rgba(6, 9, 26, 0.80);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* Desktop underline animation */
  .nav-link:hover .nav-underline { width: 100%; }

  /* CTA gradient pill */
  .nav-cta {
    background: linear-gradient(135deg, #3245FF, #BC52EE);
    box-shadow: 0 4px 16px rgba(50, 69, 255, 0.35);
  }
  .nav-cta:hover {
    box-shadow: 0 8px 28px rgba(50, 69, 255, 0.5);
  }

  /* Mobile menu panel */
  .mobile-menu-panel {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    background: rgba(6, 9, 26, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.25s ease;
    pointer-events: none;
  }

  .mobile-menu-panel.open {
    max-height: 400px;
    opacity: 1;
    pointer-events: auto;
  }

  /* Backdrop */
  .nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }

  .nav-backdrop.open {
    display: block;
  }

  /* Hamburger → X animation */
  .ham-open #ham-line1 {
    transform: translateY(7px) rotate(45deg);
    width: 20px;
  }
  .ham-open #ham-line2 {
    opacity: 0;
    transform: scaleX(0);
  }
  .ham-open #ham-line3 {
    transform: translateY(-7px) rotate(-45deg);
    width: 20px;
  }

  /* Scroll darken */
  @supports (animation-timeline: scroll()) {
    .navbar-bg {
      animation: navDarken linear both;
      animation-timeline: scroll();
      animation-range: 0px 120px;
    }
    @keyframes navDarken {
      from { background: rgba(6, 9, 26, 0.0); }
      to   { background: rgba(6, 9, 26, 0.95); }
    }
  }
</style>

<script>
  const hamburger = document.getElementById('nav-hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('nav-backdrop');

  function openMenu() {
    mobileMenu?.classList.add('open');
    backdrop?.classList.add('open');
    hamburger?.classList.add('ham-open');
    hamburger?.setAttribute('aria-expanded', 'true');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.remove('open');
    backdrop?.classList.remove('open');
    hamburger?.classList.remove('ham-open');
    hamburger?.setAttribute('aria-expanded', 'false');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('open');
    isOpen ? closeMenu() : openMenu();
  });

  // Close on backdrop click
  backdrop?.addEventListener('click', closeMenu);

  // Close when a nav link is clicked
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // Close menu if window resized to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) closeMenu();
  });
</script>
