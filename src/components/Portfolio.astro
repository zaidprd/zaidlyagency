---
import { Image } from 'astro:assets';
import port1 from '../assets/portfolio-1.webp';
import port2 from '../assets/portfolio-4.webp';
import port3 from '../assets/portfolio-5.webp';

const projects = [
  { img: port1, alt: 'Website E-Commerce UMKM',    category: 'Company Profile', title: 'Panel Maker Type Test' },
  { img: port2, alt: 'Website Company Profile',     category: 'Company Profile', title: 'Logistik' },
  { img: port3, alt: 'Landing Page Affiliate',      category: 'Affiliate',       title: 'Affiliate Marketing Amazon' },
];
---

<section id="portfolio" class="py-28 bg-[#06091a] relative overflow-hidden">

  <div class="absolute bottom-0 right-0 w-[500px] h-[400px]
              bg-[radial-gradient(ellipse,rgba(188,82,238,0.06)_0%,transparent_70%)]
              pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">

    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="section-label">Portfolio Kami</span>
      <h2 class="font-heading font-black uppercase text-4xl md:text-5xl leading-[0.9] tracking-tighter text-white mb-6">
        Karya <span class="text-gradient-static">Terbaru</span> Untuk Klien Istimewa.
      </h2>
      <p class="text-white/40 text-sm md:text-base leading-relaxed">
        Lihat bagaimana kami membantu berbagai bisnis dan UMKM bertransformasi secara digital dengan website yang modern dan performa tinggi.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((p) => (
        <div class="group relative rounded-[20px] overflow-hidden
                    border border-white/[0.04] hover:border-[#3245FF]/30
                    transition-all duration-500 hover:-translate-y-2
                    shadow-[0_0_0_0] hover:shadow-[0_30px_60px_rgba(0,0,0,0.5)]">

          <div class="overflow-hidden">
            <Image
              src={p.img}
              alt={p.alt}
              class="w-full h-auto transition-transform duration-700 group-hover:scale-110"
            />
          </div>

          <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0e]/95 via-[#0a0a0e]/40 to-transparent
                      opacity-0 group-hover:opacity-100 transition-opacity duration-500
                      flex flex-col justify-end p-7">
            <span class="text-[#3245FF] font-black text-[10px] uppercase tracking-[0.3em] mb-2">{p.category}</span>
            <h3 class="font-heading text-white text-2xl">{p.title}</h3>
          </div>

        </div>
      ))}
    </div>

    <div class="text-center mt-14">
      <a href="/portfolio" class="btn-ghost">
        Lihat Semua Project
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
