---
const steps = [
  {
    num: '01',
    title: 'Konsultasi & Strategi',
    desc: 'Kami dengarkan kebutuhan Anda. Apakah butuh WordPress yang mudah diedit sendiri atau Astro untuk kecepatan maksimal?',
  },
  {
    num: '02',
    title: 'Desain Kreatif',
    desc: 'Pembuatan mockup yang modern. Jika pakai WordPress, kami siapkan desain yang kompatibel dengan sistem drag & drop.',
  },
  {
    num: '03',
    title: 'Development',
    desc: 'Eksekusi menggunakan WordPress untuk kemudahan kelola, atau Astro untuk performa high-end yang super kencang.',
  },
  {
    num: '04',
    title: 'Training & Support',
    desc: 'Website live! Kami ajarkan cara pakai fitur drag & drop agar Anda mahir mengelola konten website sendiri.',
  },
];
---

<section id="process" class="py-28 bg-[#0E100E] relative overflow-hidden">

  <div class="absolute top-0 right-0 w-[500px] h-[500px]
              bg-[radial-gradient(ellipse,rgba(62,207,142,0.05)_0%,transparent_70%)]
              pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid lg:grid-cols-[1fr_2fr] gap-16 xl:gap-24 items-start">

      <!-- Left: heading -->
      <div class="lg:sticky lg:top-32">
        <span class="section-label">Alur Kerja Kami</span>
        <h2 class="font-heading font-extrabold text-4xl md:text-[2.75rem] leading-[1.1] tracking-tight text-white mb-6">
          Cara kami <span class="word-accent">mewujudkan</span> website impian Anda.
        </h2>
        <p class="text-white/50 leading-relaxed mb-8 max-w-sm">
          Proses transparan menggunakan platform yang sesuai dengan kebutuhan bisnis Anda, baik WordPress maupun Custom Code.
        </p>
        <a href="https://wa.me/6281274203815" target="_blank" class="btn-premium">
          Mulai Project Sekarang
        </a>
      </div>

      <!-- Right: steps grid -->
      <div class="grid sm:grid-cols-2 gap-6">
        {steps.map((step) => (
          <div class="card-premium p-8 group">

            <div class="inline-flex items-center justify-center w-11 h-11 rounded-full mb-5
                        border border-[#3ECF8E]/25 bg-[#3ECF8E]/[0.06]
                        text-[#3ECF8E] font-bold text-sm
                        group-hover:bg-[#3ECF8E] group-hover:text-[#07100B] transition-colors duration-500">
              {step.num}
            </div>

            <h3 class="font-heading font-bold text-white text-lg mb-3">
              {step.title}
            </h3>

            <p class="text-white/45 text-sm leading-relaxed">
              {step.desc}
            </p>

            <div class="mt-5 h-[1px] w-0 group-hover:w-full transition-all duration-500 bg-[#3ECF8E]/60"></div>

          </div>
        ))}
      </div>

    </div>
  </div>
</section>
