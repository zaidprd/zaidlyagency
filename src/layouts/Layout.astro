---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  keywords?: string;
}

const {
  title,
  description = "Zaidly Agency membantu UMKM go-online dengan jasa pembuatan website profesional, cepat, dan terjangkau.",
  ogImage = "/og-image.svg",
  keywords = "jasa website umkm, bikin website murah, jasa digital agency, website profesional"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://zaidly.com");
const ogImageURL = new URL(ogImage, "https://zaidly.com").href;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Zaidly Agency",
  "description": "Jasa pembuatan website profesional untuk UMKM Indonesia",
  "url": "https://zaidly.com",
  "telephone": "+6281274203815",
  "email": "hello@zaidly.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Jl. H Taha",
    "addressLocality": "Kebon Jeruk",
    "addressRegion": "Jakarta",
    "addressCountry": "ID"
  },
  "priceRange": "Rp 588.000 - Rp 2.588.000",
  "sameAs": ["https://zaidly.com"]
});
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Zaidly Agency" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={schema}></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Poppins:wght@800;900&display=swap" rel="stylesheet" />

  </head>
  <body class="bg-[#06091a] text-white overflow-x-hidden m-0 p-0 antialiased">

    <!-- Ambient background orbs -->
    <div class="fixed top-[-15%] left-[-10%] w-[55%] h-[55%] bg-[#3245FF]/[0.05] blur-[140px] rounded-full z-[-2] pointer-events-none"></div>
    <div class="fixed bottom-[-15%] right-[-10%] w-[55%] h-[55%] bg-[#BC52EE]/[0.05] blur-[140px] rounded-full z-[-2] pointer-events-none"></div>

    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
